# Server-only settings. Never add a VITE_ prefix to secrets.
# Local: use exactly the same origin in your browser and Google OAuth callback.
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Hosted ChatGPT identity: use only Microfish's OpenAI-provisioned web client.
# Register /api/auth/callback/chatgpt for each exact AUTH_URL.
# OpenAI approval is required: https://openai.com/form/sign-in-with-chatgpt-interest/
AUTH_OPENAI_ID=
# Set to the authentication method OpenAI registered: none or client_secret_basic.
AUTH_OPENAI_TOKEN_AUTH_METHOD=
# Required only for a confidential client using client_secret_basic.
AUTH_OPENAI_SECRET=

# Optional advanced API-key connection. Separate from ChatGPT subscription usage,
# which remains unavailable pending approved hosted plan-usage integration details.
OPENAI_MODEL=gpt-4.1-mini
