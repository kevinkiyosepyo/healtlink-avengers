# Server-only settings. Never add a VITE_ prefix to secrets.
# Local: use exactly the same origin in your browser and Google OAuth callback.
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Researchers connect their own OpenAI API key after Google sign-in.
# This optional default model is a server setting; API keys are never VITE_ variables.
OPENAI_MODEL=gpt-4.1-mini

# Opt-in cloud backup for the research workspace. Production uses DynamoDB.
# Local development without AWS: SYNC_MEMORY=1 keeps backups in server memory.
SYNC_TABLE=
AWS_REGION=us-west-2
SYNC_MEMORY=
